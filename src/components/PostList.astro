---
import { formattedDate, postHref, type TistoryEntry } from "../lib/blog.ts"

type Props = {
  readonly posts: readonly TistoryEntry[]
}

const { posts } = Astro.props
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li data-post-id={post.data.id}>
        <a class="post-row" href={postHref(post)}>
          <span class="post-date">{formattedDate(post.data.publishedAt)}</span>
          <span class="post-row-main">
            <strong>{post.data.title}</strong>
            <span>{post.data.description}</span>
          </span>
          <span class="post-category">{post.data.category}</span>
        </a>
      </li>
    ))
  }
</ol>
