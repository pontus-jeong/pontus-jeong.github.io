  "bodyHtml": "\n                            <p style=\"text-align: center; clear: none; float: none;\"></p><figure class=\"imageblock alignCenter\" width=\"1000\" height=\"545\" filename=\"63fafcdfa976d452a1bb1aa34c9b6fc5b23e0bcd.png\" filemime=\"image/jpeg\" style=\"\" \"\"=\"\">\n    <span data-lightbox=\"lightbox\">\n        <img src=\"/assets/posts/1/img-001.png\" width=\"1000\" height=\"545\" filename=\"63fafcdfa976d452a1bb1aa34c9b6fc5b23e0bcd.png\" filemime=\"image/jpeg\" style=\"\" \"\"=\"\">\n    </span>\n    <figcaption></figcaption>\n</figure><p></p><p><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\"></span><br></p><div id=\"wrap_img\" style=\"margin: 0px; padding: 0px; border: 0px; color: rgb(51, 51, 51); font-size: 12px; font-family: dotum, 돋움, gulim, 굴림, Helvetica, Apple-Gothic, sans-serif, &quot;Malgun Gothic&quot;, &quot;맑은 고딕&quot;; width: 875px; text-align: center;\"><br style=\"margin: 0px; padding: 0px; border: 0px;\"></div><div id=\"wrap_body\" style=\"margin: 10px 20px 20px; padding: 0px; border: 0px; color: rgb(51, 51, 51); font-size: 12px; font-family: dotum, 돋움, gulim, 굴림, Helvetica, Apple-Gothic, sans-serif, &quot;Malgun Gothic&quot;, &quot;맑은 고딕&quot;; word-break: break-all; line-height: 1.8em;\"><span id=\"ai_cm_content\" style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">일단&nbsp;제가&nbsp;만들고&nbsp;있는&nbsp;사이트가&nbsp;컨텐츠인만큼,&nbsp;이러한&nbsp;것에&nbsp;부담이&nbsp;있으신&nbsp;분들에게&nbsp;죄송하다는&nbsp;말씀부터&nbsp;드리고&nbsp;시작하겠습니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><br style=\"margin: 0px; padding: 0px; border: 0px;\"><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">현재&nbsp;제가&nbsp;개발하려고&nbsp;하는&nbsp;건,&nbsp;</span><b><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">애니메이션&nbsp;추천&nbsp;사이트</span></b><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">개념은 이렇습니다.</span></span></div><div id=\"wrap_body\" style=\"margin: 10px 20px 20px; padding: 0px; border: 0px; color: rgb(51, 51, 51); font-size: 12px; font-family: dotum, 돋움, gulim, 굴림, Helvetica, Apple-Gothic, sans-serif, &quot;Malgun Gothic&quot;, &quot;맑은 고딕&quot;; word-break: break-all; line-height: 1.8em;\"><span style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">한&nbsp;유저에게&nbsp;자신이&nbsp;지금까지&nbsp;본&nbsp;애니&nbsp;중&nbsp;감명&nbsp;받았거나&nbsp;추천하고&nbsp;싶은&nbsp;애니&nbsp;5편을&nbsp;고르게&nbsp;한&nbsp;다음,</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그러한&nbsp;데이터들을&nbsp;축적시킵니다.&nbsp;그러면&nbsp;{애니1,&nbsp;애니2,&nbsp;애니3,&nbsp;애니4,&nbsp;애니5}</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">이러한&nbsp;배열이&nbsp;만들어지게&nbsp;되고,&nbsp;이&nbsp;배열들을&nbsp;저장합니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그러면&nbsp;이렇게&nbsp;데이터가&nbsp;모아졌을&nbsp;때,</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">만약에&nbsp;자신이&nbsp;애니1을&nbsp;보았고,&nbsp;이와&nbsp;비슷하거나,&nbsp;자신의&nbsp;취향과&nbsp;비슷한&nbsp;다른&nbsp;애니를&nbsp;찾으려&nbsp;할&nbsp;것입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그러면&nbsp;많은&nbsp;배열&nbsp;중에서&nbsp;먼저&nbsp;애니&nbsp;1이&nbsp;들어있는&nbsp;배열들을&nbsp;찾습니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그&nbsp;중에서&nbsp;많은&nbsp;분포를&nbsp;보인&nbsp;애니를&nbsp;순서대로&nbsp;추천해주는&nbsp;것입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">또&nbsp;다른&nbsp;방법으로는&nbsp;페북처럼&nbsp;좋아요&nbsp;버튼을&nbsp;활용하는&nbsp;것입니다.</span></span></div><div id=\"wrap_body\" style=\"margin: 10px 20px 20px 2em; padding: 0px; border: 0px; color: rgb(51, 51, 51); font-size: 12px; font-family: dotum, 돋움, gulim, 굴림, Helvetica, Apple-Gothic, sans-serif, &quot;Malgun Gothic&quot;, &quot;맑은 고딕&quot;; word-break: break-all; line-height: 1.8em;\"><span style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">사실&nbsp;이&nbsp;방법을&nbsp;사용하면&nbsp;많은&nbsp;데이터를&nbsp;축적할&nbsp;수&nbsp;있을&nbsp;것&nbsp;같습니다만,&nbsp;그만큼&nbsp;정밀한&nbsp;데이터가&nbsp;나오기&nbsp;힘들&nbsp;것&nbsp;같은게&nbsp;제&nbsp;예상입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">웹사이트를&nbsp;제작하는&nbsp;데는&nbsp;RoR(Ruby&nbsp;on&nbsp;Rails)&nbsp;기반으로&nbsp;할&nbsp;예정입니다.&nbsp;현재&nbsp;그&nbsp;언어를&nbsp;위주로&nbsp;배운&nbsp;것&nbsp;때문이기도&nbsp;하고,&nbsp;DB같은&nbsp;거&nbsp;짜는&nbsp;게&nbsp;다른&nbsp;언어에&nbsp;비해&nbsp;쉽기도&nbsp;해서&nbsp;초보자가&nbsp;개발하는&nbsp;데는&nbsp;적합한&nbsp;것&nbsp;같습니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그리고,&nbsp;현재&nbsp;개발하면서&nbsp;조금&nbsp;힘든&nbsp;문제가&nbsp;사용자&nbsp;데이터를&nbsp;모으기&nbsp;이전에&nbsp;애니&nbsp;관련&nbsp;데이터를&nbsp;모아야&nbsp;합니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그래서&nbsp;검색&nbsp;API(네이버,&nbsp;다음,&nbsp;구글)을&nbsp;이용해&nbsp;보려고&nbsp;했으나,&nbsp;원하는&nbsp;정보를&nbsp;얻기는&nbsp;힘들&nbsp;것&nbsp;같습니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그래서&nbsp;수소문&nbsp;끝에&nbsp;http://onnada.com/&nbsp;이란&nbsp;사이트를&nbsp;발견하였고,&nbsp;여기에&nbsp;있는&nbsp;검색&nbsp;결과를&nbsp;파싱해서&nbsp;정보를&nbsp;수집할&nbsp;예정입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">일단&nbsp;애니란&nbsp;부분이&nbsp;광범위하기&nbsp;때문에,&nbsp;저&nbsp;혼자서&nbsp;애니&nbsp;데이터를&nbsp;축척시키는&nbsp;데는&nbsp;많은&nbsp;어려움이&nbsp;있어,&nbsp;사용자들이&nbsp;정보를&nbsp;추가시켜&nbsp;대규모의&nbsp;프로젝트를&nbsp;수행할&nbsp;수&nbsp;있는&nbsp;\"집단지성\"&nbsp;방식을&nbsp;사용할&nbsp;예정입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">UI는&nbsp;Google의&nbsp;Material&nbsp;Design을&nbsp;기반으로&nbsp;제작할&nbsp;예정이며,&nbsp;이는&nbsp;Material&nbsp;Design&nbsp;Lite를&nbsp;통해서&nbsp;구현할&nbsp;것입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">일단은&nbsp;지금은&nbsp;백엔드&nbsp;구현이&nbsp;아닌,&nbsp;프론트&nbsp;엔드만을&nbsp;구현하는&nbsp;것으로&nbsp;목록에&nbsp;사진,&nbsp;제목,&nbsp;정보,&nbsp;더&nbsp;자세한&nbsp;정보로&nbsp;연결하는&nbsp;버튼&nbsp;이렇게&nbsp;구성하고&nbsp;있으며,&nbsp;이는&nbsp;제작&nbsp;과정에서&nbsp;많이&nbsp;바뀔수도&nbsp;있을&nbsp;것&nbsp;같습니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">마지막으로,&nbsp;왜&nbsp;이글을&nbsp;쓰는지에&nbsp;대해서&nbsp;얘기하겠습니다.&nbsp;사실&nbsp;개발하는&nbsp;데&nbsp;실력도&nbsp;중요하지만,&nbsp;개발자들에게&nbsp;가장&nbsp;중요한&nbsp;것은&nbsp;끈기라고&nbsp;생각합니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">그래서&nbsp;저는&nbsp;이러한&nbsp;제작&nbsp;과정&nbsp;글을&nbsp;일기처럼&nbsp;계속&nbsp;올리면,&nbsp;이걸&nbsp;올리기&nbsp;위해서라도&nbsp;조금씩&nbsp;만들&nbsp;것&nbsp;같아서&nbsp;매일&nbsp;또는&nbsp;며칠마다&nbsp;한번씩&nbsp;계속&nbsp;개발&nbsp;과정을&nbsp;올릴&nbsp;예정입니다.</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">&nbsp;</span><br style=\"margin: 0px; padding: 0px; border: 0px;\"><span style=\"font-family: &quot;맑은 고딕&quot;, sans-serif;\">P.S.&nbsp;전체&nbsp;소스코드는&nbsp;나중에&nbsp;올리겠습니다.&nbsp;아직&nbsp;공개할&nbsp;정도로&nbsp;만든&nbsp;상태는&nbsp;아닌지라요...</span></span></div><p><br></p>\n                        ",
